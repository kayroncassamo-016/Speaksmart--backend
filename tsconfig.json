{
  "compilerOptions": {
    "target": "ES2022",
    
    "module": "ESNEXT",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "./dist",
    "noEmit": true
  },
  "include": ["src", "routes.ts"]
}